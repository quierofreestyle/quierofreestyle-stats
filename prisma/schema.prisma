  queuedAt        DateTime             @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt       DateTime?            @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?            @map("finished_at") @db.Timestamptz(3)
  summary         Json?
  error           Json?

  initiatedBy AppUser?              @relation("RecalculationInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  changes     RecalculationChange[]
  progress    BadgeProgress[]
  statistics  CompetitorStatistic[]

