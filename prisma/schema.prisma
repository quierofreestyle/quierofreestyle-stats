generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SubjectType {
  COMPETITOR
  COMPETITION
  ORGANIZATION
}

enum RecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  MERGED
}

enum SubjectNameKind {
  PRIMARY
  ALIAS
  PREVIOUS_NAME
  ABBREVIATION
}

enum RegionType {
  COUNTRY
  PROVINCE
  CITY
  NEIGHBORHOOD
}

enum CompetitiveScope {
  LOCAL
  REGIONAL
  PROVINCIAL
  NATIONAL
  INTERNATIONAL
  OTHER
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
  UNKNOWN
}

enum OrganizationType {
  ORGANIZER
  MEDIA
  LEAGUE
  COLLECTIVE
  OTHER
}

enum ProfileFieldVisibility {
  PUBLIC
  HIDDEN
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CORRECTED
  ANNULLED
}

enum EventResolution {
  DECIDED
  SHARED_CHAMPIONSHIP
  UNDECIDED
}

enum EventFormat {
  SOLO
  DUO
  TRIO
  OTHER
}

enum PlacementType {
  CHAMPION
  RUNNER_UP
  FINALIST
  OTHER
}

enum PlacementStatus {
  ACTIVE
  ANNULLED
}

enum SourceType {
  OFFICIAL
  SOCIAL
  VIDEO
  DOCUMENT
  OTHER
}

enum SourcePurpose {
  RESULT
  DATE
  PARTICIPANTS
  SCOPE
  GENERAL
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DELETED
}

enum ClaimStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  REVOKED
}

enum SubjectAccessLevel {
  OWNER
  EDITOR
  VIEWER
}

enum BadgeKind {
  UNIQUE
  ACHIEVEMENT
  TIERED
}

enum BadgeAssignmentMode {
  AUTOMATIC
  EDITORIAL
}

enum PermanenceMode {
  PERMANENT
  TEMPORARY
}

enum UniqueTiePolicy {
  FIRST_REACHED_NO_INITIAL_HOLDER
}

enum BadgeDefinitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MetricValueType {
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
}

enum RuleAggregation {
  COUNT
  SUM
  MAX
  BOOLEAN
}

enum RuleOperator {
  GTE
  EQ
  TOP_ONE
  FIRST
}

enum RuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum BadgeInstanceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BadgeScopeType {
  GLOBAL
  COMPETITION
  ORGANIZATION
  SEASON
  REGION
}

enum BadgePeriodType {
  NONE
  MONTH
  YEAR
}

enum BadgeAwardStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum TierAchievementStatus {
  ACTIVE
  REVOKED
}

enum RecalculationTrigger {
  EVENT_PUBLISHED
  EVENT_CORRECTED
  EVENT_ANNULLED
  RULE_ACTIVATED
  HISTORICAL_DATA_ADDED
  FULL_REBUILD
}

enum RecalculationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum RecalculationMode {
  APPLY
  DRY_RUN
}

enum RecalculationChangeType {
  AWARD
  REVOKE
  TRANSFER
  LEVEL_UP
  LEVEL_DOWN
  RANK_CHANGE
  NO_HOLDER
}

enum ActorType {
  USER
  SYSTEM
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum SubmissionOperation {
  CREATE
  UPDATE
  ANNUL
}

enum MigrationRecordStatus {
  MAPPED
  SKIPPED
  ERROR
}

enum MigrationIssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum MediaKind {
  AVATAR
  LOGO
  BADGE
  SHARE
  OTHER
}

enum ShareFormat {
  POST
  STORY
}

enum ShareStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum SocialProvider {
  INSTAGRAM
}

enum SocialConnectionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model AppUser {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authSubject     String     @unique @map("auth_subject")
  email           String?    @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdMediaAssets  MediaAsset[]             @relation("MediaCreatedBy")
  userRoles           UserRole[]
  profileClaims       ProfileClaim[]           @relation("ClaimRequester")
  reviewedClaims      ProfileClaim[]           @relation("ClaimReviewer")
  subjectManagements  SubjectManager[]         @relation("SubjectManagerUser")
  grantedManagements  SubjectManager[]         @relation("SubjectManagerGrantor")
  badgeDefinitions    BadgeDefinition[]        @relation("BadgeDefinitionCreator")
  ruleVersions        BadgeRuleVersion[]       @relation("RuleCreator")
  badgeAwards         BadgeAward[]             @relation("BadgeAwardAssigner")
  profilePreferences  ProfileBadgePreference[] @relation("PreferenceUpdater")
  recalculationRuns   RecalculationRun[]       @relation("RecalculationInitiator")
  submissions         DataSubmission[]         @relation("SubmissionAuthor")
  reviewedSubmissions DataSubmission[]         @relation("SubmissionReviewer")
  auditLogs           AuditLog[]
  resolvedIssues      MigrationIssue[]         @relation("IssueResolver")
  socialConnections   SocialConnection[]

  @@unique([email], map: "app_user_email_key")
  @@map("app_user")
}

model MediaAsset {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey  String    @unique @map("storage_key")
  mimeType    String    @map("mime_type")
  sizeBytes   BigInt    @map("size_bytes")
  width       Int?
  height      Int?
  kind        MediaKind
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy      AppUser?     @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  avatarSubjects Subject[]    @relation("SubjectAvatar")
  tierAssets     BadgeTier[]
  shareAssets    ShareAsset[] @relation("ShareMedia")

  @@map("media_asset")
}

model Subject {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          SubjectType
  slug          String       @db.Citext
  displayName   String       @map("display_name")
  status        RecordStatus @default(DRAFT)
  bio           String?
  avatarAssetId String?      @map("avatar_asset_id") @db.Uuid
  mergedIntoId  String?      @map("merged_into_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatar               MediaAsset?              @relation("SubjectAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  mergedInto           Subject?                 @relation("SubjectMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedSubjects       Subject[]                @relation("SubjectMerge")
  names                SubjectName[]
  competitor           Competitor?
  competition          Competition?
  organization         Organization?
  profileClaims        ProfileClaim[]
  managers             SubjectManager[]
  badgeAwards          BadgeAward[]
  badgeHoldings        BadgeHoldingPeriod[]
  badgeProgress        BadgeProgress[]
  tierAchievements     TierAchievement[]
  badgePreferences     ProfileBadgePreference[]
  recalculationChanges RecalculationChange[]
  shareAssets          ShareAsset[]
  declaredEventScopes  Event[]                  @relation("EventScopeDeclarant")

  @@unique([type, slug])
  @@index([type, status])
  @@map("subject")
}

model SubjectName {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId       String          @map("subject_id") @db.Uuid
  value           String
  normalizedValue String          @map("normalized_value") @db.Citext
  kind            SubjectNameKind
  validFrom       DateTime?       @map("valid_from") @db.Date
  validTo         DateTime?       @map("valid_to") @db.Date
  isSearchable    Boolean         @default(true) @map("is_searchable")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([normalizedValue])
  @@index([subjectId, kind])
  @@map("subject_name")
}

model Region {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  type      RegionType
  name      String
  code      String?
  slug      String     @db.Citext
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent              Region?       @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Region[]      @relation("RegionHierarchy")
  competitors         Competitor[]
  competitionDefaults Competition[] @relation("CompetitionDefaultRegion")
  eventLocations      Event[]       @relation("EventLocationRegion")
  eventScopes         Event[]       @relation("EventScopeRegion")
  venues              Venue[]
  badgeScopes         BadgeScope[]

  @@unique([parentId, slug])
  @@index([type, name])
  @@map("region")
}

model Competitor {
  subjectId           String                 @id @map("subject_id") @db.Uuid
  homeRegionId        String?                @map("home_region_id") @db.Uuid
  birthDate           DateTime?              @map("birth_date") @db.Date
  birthDateVisibility ProfileFieldVisibility @default(HIDDEN) @map("birth_date_visibility")
  locationVisibility  ProfileFieldVisibility @default(PUBLIC) @map("location_visibility")

  subject    Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  homeRegion Region?              @relation(fields: [homeRegionId], references: [id], onDelete: SetNull)
  placements PlacementMember[]
  statistics CompetitorStatistic?

  @@map("competitor")
}

model CompetitorStatistic {
  competitorId           String    @id @map("competitor_id") @db.Uuid
  championships          Int       @default(0)
  runnerUps              Int       @default(0) @map("runner_ups")
  finals                 Int       @default(0)
  individualTitles       Int       @default(0) @map("individual_titles")
  groupTitles            Int       @default(0) @map("group_titles")
  firstFinalOn           DateTime? @map("first_final_on") @db.Date
  lastFinalOn            DateTime? @map("last_final_on") @db.Date
  championshipsReachedAt DateTime? @map("championships_reached_at") @db.Date
  runnerUpsReachedAt     DateTime? @map("runner_ups_reached_at") @db.Date
  finalsReachedAt        DateTime? @map("finals_reached_at") @db.Date
  calculatedAt           DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(3)
  runId                  String    @map("run_id") @db.Uuid

  competitor Competitor       @relation(fields: [competitorId], references: [subjectId], onDelete: Restrict)
  run        RecalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([championships, championshipsReachedAt])
  @@index([finals, finalsReachedAt])
  @@map("competitor_statistic")
}

model Organization {
  subjectId        String           @id @map("subject_id") @db.Uuid
  organizationType OrganizationType @default(ORGANIZER) @map("organization_type")
  foundedOn        DateTime?        @map("founded_on") @db.Date
  websiteUrl       String?          @map("website_url")

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  competitions Competition[]
  badgeScopes  BadgeScope[]

  @@map("organization")
}

model Competition {
  subjectId       String           @id @map("subject_id") @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  shortName       String?          @map("short_name")
  defaultScope    CompetitiveScope @default(LOCAL) @map("default_scope")
  defaultRegionId String?          @map("default_region_id") @db.Uuid
  foundedOn       DateTime?        @map("founded_on") @db.Date

  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  organization  Organization @relation(fields: [organizationId], references: [subjectId], onDelete: Restrict)
  defaultRegion Region?      @relation("CompetitionDefaultRegion", fields: [defaultRegionId], references: [id], onDelete: SetNull)
  seasons       Season[]
  events        Event[]
  badgeScopes   BadgeScope[]

  @@index([organizationId])
  @@map("competition")
}

model Venue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId  String   @map("region_id") @db.Uuid
  name      String
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  region Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  events Event[]

  @@index([regionId, name])
  @@map("venue")
}

model Season {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId String       @map("competition_id") @db.Uuid
  name          String
  startsOn      DateTime?    @map("starts_on") @db.Date
  endsOn        DateTime?    @map("ends_on") @db.Date
  status        SeasonStatus @default(DRAFT)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition  @relation(fields: [competitionId], references: [subjectId], onDelete: Restrict)
  events      Event[]
  badgeScopes BadgeScope[]

  @@unique([competitionId, name])
  @@unique([id, competitionId])
  @@map("season")
}

model Event {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competitionId     String           @map("competition_id") @db.Uuid
  seasonId          String?          @map("season_id") @db.Uuid
  venueId           String?          @map("venue_id") @db.Uuid
  locationRegionId  String?          @map("location_region_id") @db.Uuid
  scopeRegionId     String?          @map("scope_region_id") @db.Uuid
  slug              String           @db.Citext
  title             String
  editionNumber     Int?             @map("edition_number")
  eventYear         Int?             @map("event_year")
  eventMonth        Int?             @map("event_month")
  eventDay          Int?             @map("event_day")
  occurredOn        DateTime?        @map("occurred_on") @db.Date
  datePrecision     DatePrecision    @default(UNKNOWN) @map("date_precision")
  officialScope     CompetitiveScope @default(LOCAL) @map("official_scope")
  scopeDeclaredById String?          @map("scope_declared_by_id") @db.Uuid
  scopeSourceUrl    String?          @map("scope_source_url")
  scopeNotes        String?          @map("scope_notes")
  format            EventFormat      @default(SOLO)
  resolution        EventResolution  @default(DECIDED)
  status            EventStatus      @default(DRAFT)
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz(3)
  publishedById     String?          @map("published_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition      Competition          @relation(fields: [competitionId], references: [subjectId], onDelete: Restrict)
  season           Season?              @relation(fields: [seasonId, competitionId], references: [id, competitionId], onDelete: Restrict)
  venue            Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  locationRegion   Region?              @relation("EventLocationRegion", fields: [locationRegionId], references: [id], onDelete: SetNull)
  scopeRegion      Region?              @relation("EventScopeRegion", fields: [scopeRegionId], references: [id], onDelete: SetNull)
  scopeDeclaredBy  Subject?             @relation("EventScopeDeclarant", fields: [scopeDeclaredById], references: [id], onDelete: SetNull)
  placements       Placement[]
  sources          EventSource[]
  badgeAwards      BadgeAward[]
  acquiredHoldings BadgeHoldingPeriod[] @relation("HoldingAcquiredEvent")
  endedHoldings    BadgeHoldingPeriod[] @relation("HoldingEndedEvent")
  tierAchievements TierAchievement[]

  @@unique([competitionId, slug])
  @@index([competitionId, eventYear, eventMonth, eventDay])
  @@index([status, officialScope])
  @@map("event")
}

model Placement {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String          @map("event_id") @db.Uuid
  position   Int
  slot       Int             @default(1)
  type       PlacementType
  groupLabel String?         @map("group_label")
  status     PlacementStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  members PlacementMember[]

  @@unique([eventId, position, slot])
  @@index([eventId, type, status])
  @@map("placement")
}

model PlacementMember {
  placementId        String  @map("placement_id") @db.Uuid
  competitorId       String  @map("competitor_id") @db.Uuid
  memberOrder        Int     @default(1) @map("member_order")
  displayNameAtEvent String? @map("display_name_at_event")

  placement  Placement  @relation(fields: [placementId], references: [id], onDelete: Restrict)
  competitor Competitor @relation(fields: [competitorId], references: [subjectId], onDelete: Restrict)

  @@id([placementId, competitorId])
  @@index([competitorId])
  @@map("placement_member")
}

model Source {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  title      String?
  publisher  String?
  type       SourceType
  isArchived Boolean    @default(false) @map("is_archived")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  events EventSource[]

  @@index([url])
  @@map("source")
}

model EventSource {
  eventId  String        @map("event_id") @db.Uuid
  sourceId String        @map("source_id") @db.Uuid
  purpose  SourcePurpose @default(GENERAL)

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([eventId, sourceId, purpose])
  @@map("event_source")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  description String?

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]

  @@map("permission")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedBy String?  @map("granted_by") @db.Uuid

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model ProfileClaim {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  subjectId    String      @map("subject_id") @db.Uuid
  status       ClaimStatus @default(SUBMITTED)
  evidence     Json?
  privateNotes String?     @map("private_notes")
  reviewedById String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       AppUser  @relation("ClaimRequester", fields: [userId], references: [id], onDelete: Restrict)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  reviewedBy AppUser? @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([subjectId, status])
  @@index([userId, status])
  @@map("profile_claim")
}

model SubjectManager {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  subjectId   String             @map("subject_id") @db.Uuid
  accessLevel SubjectAccessLevel @map("access_level")
  validFrom   DateTime           @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo     DateTime?          @map("valid_to") @db.Timestamptz(3)
  grantedById String?            @map("granted_by_id") @db.Uuid

  user      AppUser  @relation("SubjectManagerUser", fields: [userId], references: [id], onDelete: Restrict)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  grantedBy AppUser? @relation("SubjectManagerGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, subjectId])
  @@index([subjectId, validTo])
  @@map("subject_manager")
}

model BadgeDefinition {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                @unique
  kind                BadgeKind
  assignmentMode      BadgeAssignmentMode   @map("assignment_mode")
  nameTemplate        String                @map("name_template")
  descriptionTemplate String                @map("description_template")
  recipientType       SubjectType           @map("recipient_type")
  permanenceMode      PermanenceMode        @default(PERMANENT) @map("permanence_mode")
  tiePolicy           UniqueTiePolicy?      @map("tie_policy")
  status              BadgeDefinitionStatus @default(DRAFT)
  createdById         String                @map("created_by_id") @db.Uuid
  archivedAt          DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    AppUser            @relation("BadgeDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ruleVersions BadgeRuleVersion[]
  instances    BadgeInstance[]

  @@index([recipientType, status])
  @@map("badge_definition")
}

model MetricDefinition {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String          @unique
  name              String
  description       String
  valueType         MetricValueType @map("value_type")
  implementationKey String          @map("implementation_key")
  version           Int             @default(1)
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  recipientTypes MetricRecipientType[]
  ruleVersions   BadgeRuleVersion[]

  @@map("metric_definition")
}

model MetricRecipientType {
  metricId      String      @map("metric_id") @db.Uuid
  recipientType SubjectType @map("recipient_type")

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Restrict)

  @@id([metricId, recipientType])
  @@map("metric_recipient_type")
}

model BadgeRuleVersion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  badgeDefinitionId String          @map("badge_definition_id") @db.Uuid
  metricId          String          @map("metric_id") @db.Uuid
  versionNumber     Int             @map("version_number")
  aggregation       RuleAggregation
  operator          RuleOperator
  baseThreshold     Decimal?        @map("base_threshold") @db.Decimal(18, 4)
  config            Json            @default("{}")
  effectiveFrom     DateTime?       @map("effective_from") @db.Date
  effectiveTo       DateTime?       @map("effective_to") @db.Date
  status            RuleStatus      @default(DRAFT)
  createdById       String          @map("created_by_id") @db.Uuid
  reason            String
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  badgeDefinition  BadgeDefinition      @relation(fields: [badgeDefinitionId], references: [id], onDelete: Restrict)
  metric           MetricDefinition     @relation(fields: [metricId], references: [id], onDelete: Restrict)
  createdBy        AppUser              @relation("RuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tiers            BadgeTier[]
  awards           BadgeAward[]
  holdingPeriods   BadgeHoldingPeriod[]
  progress         BadgeProgress[]
  tierAchievements TierAchievement[]

  @@unique([badgeDefinitionId, versionNumber])
  @@index([badgeDefinitionId, status, effectiveFrom])
  @@map("badge_rule_version")
}

model BadgeTier {
