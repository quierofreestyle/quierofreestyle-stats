  beforeState     Json?                   @map("before_state")
  afterState      Json?                   @map("after_state")
  appliedAt       DateTime?               @map("applied_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  run           RecalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  badgeInstance BadgeInstance?   @relation(fields: [badgeInstanceId], references: [id], onDelete: Restrict)
  subject       Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([runId, changeType])
  @@map("recalculation_change")
}

